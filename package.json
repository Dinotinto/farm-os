{
  "name": "dinotinto-farm-os",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/postinstall-prisma.mjs",
    "deploy:build": "npm run build",
    "deploy:check": "npm run prod:env && npm run lint && npm run deploy:build",
    "prod:env": "node scripts/check-production-env.mjs",
    "prod:prisma:generate": "prisma generate --schema prisma/schema.postgres.prisma",
    "prod:db:push": "prisma db push --schema prisma/schema.postgres.prisma --skip-generate",
    "prod:db:seed": "node scripts/seed-sample-farm.mjs",
    "prod:file:env": "node scripts/with-env.mjs .env.prod.local node scripts/check-production-env.mjs",
    "prod:file:prisma:generate": "node scripts/with-env.mjs .env.prod.local npx prisma generate --schema prisma/schema.postgres.prisma",
    "prod:file:db:push": "node scripts/with-env.mjs .env.prod.local npx prisma db push --schema prisma/schema.postgres.prisma --skip-generate",
    "prod:file:db:seed": "node scripts/with-env.mjs .env.prod.local node scripts/seed-sample-farm.mjs",
    "uat:env": "node scripts/with-env.mjs .env.uat node scripts/check-production-env.mjs",
    "uat:prisma:generate": "node scripts/with-env.mjs .env.uat npx prisma generate --schema prisma/schema.postgres.prisma",
    "uat:db:push": "node scripts/with-env.mjs .env.uat npx prisma db push --schema prisma/schema.postgres.prisma --skip-generate",
    "uat:db:setup": "node scripts/with-env.mjs .env.uat node scripts/setup-uat-postgres.mjs",
    "uat:db:seed": "node scripts/with-env.mjs .env.uat node scripts/seed-sample-farm.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:init": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script | prisma db execute --stdin --schema prisma/schema.prisma",
    "db:import-json": "node scripts/import-json-to-prisma.mjs",
    "db:seed-sample": "node scripts/seed-sample-farm.mjs",
    "user:hash": "node scripts/farm-user.mjs",
    "user:add": "node scripts/farm-user.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "lucide-react": "^0.561.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@bubblewrap/core": "^1.24.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
