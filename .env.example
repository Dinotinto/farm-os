# Local development. Copy to .env and fill in.
# Never commit real values: .env files other than these *.example ones are git-ignored.

DATABASE_URL="file:./dev.db"

# Signs login cookies. 32+ random characters, different for each environment:
#   openssl rand -hex 32
SESSION_SECRET=""

# Farm accounts as a JSON array. Create each entry with:
#   npm run user:add -- --email you@example.com --name "Your Name" --role owner
# then paste the entries in, e.g. FARM_USERS='[{...},{...}]'
FARM_USERS='[]'

# Optional: unlocks /admin. Create with: npm run user:hash
ADMIN_PASSWORD_HASH=""

# AI features (Gemini). Leave blank to use the built-in rules assistant.
GEMINI_API_KEY=""
GEMINI_MODEL=""
